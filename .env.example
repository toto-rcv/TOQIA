# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a `.env` y completá los valores.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# Cadena de conexión que usan Drizzle ORM y drizzle-kit.
# Con el docker-compose de este repo, los valores por defecto ya funcionan.
DATABASE_URL="mysql://pulseras:pulseras@127.0.0.1:3306/pulseras"

# Estas cuatro las lee docker-compose.yml para crear el contenedor.
# Si cambiás alguna, actualizá también DATABASE_URL.
MYSQL_ROOT_PASSWORD="rootpass"
MYSQL_DATABASE="pulseras"
MYSQL_USER="pulseras"
MYSQL_PASSWORD="pulseras"
MYSQL_PORT="3306"

# ── Autenticación (Better Auth) ──────────────────────────────────────────────
# Secreto para firmar las sesiones. OBLIGATORIO cambiarlo en producción.
# Generalo con:  openssl rand -base64 32
BETTER_AUTH_SECRET="cambiame-por-un-secreto-largo-y-aleatorio"

# URL pública desde la que se sirve la app. En local dejala en localhost.
# En producción tiene que ser el dominio real con https.
BETTER_AUTH_URL="http://localhost:3000"

# ── Aplicación ───────────────────────────────────────────────────────────────
# Origen público que se usa para armar las URLs que se graban en las pulseras
# (ej. https://midominio.com/r/B001). En local, si vas a probar desde el
# celular, poné acá la IP de tu máquina en la LAN: http://192.168.0.15:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Salt del hash de IPs. Las IPs NUNCA se guardan en claro: se guarda
# SHA-256(salt + ip). Cambiar este valor invalida la correlación con los
# hashes ya guardados, que es justamente lo que lo hace útil.
# Generalo con:  openssl rand -hex 32
IP_HASH_SALT="cambiame-por-un-salt-aleatorio"

# TTL del caché en memoria del endpoint de redirección, en segundos.
# Es el retraso máximo entre cambiar un destino en el panel y que la pulsera
# empiece a redirigir al destino nuevo.
REDIRECT_CACHE_TTL_SECONDS="60"

# ── Semilla (solo desarrollo) ────────────────────────────────────────────────
# Credenciales del usuario admin que crea `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@pulseras.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="Administrador"

# ── Producción ───────────────────────────────────────────────────────────────
# Puerto en el que escucha el server de Next detrás de Caddy.
PORT="3000"
NODE_ENV="development"

# Desfase horario de los reportes respecto de UTC, en horas.
# Argentina es -3 todo el año (no tiene horario de verano). Las fechas se
# guardan siempre en UTC; esto solo define dónde empieza y termina un "día"
# en las estadísticas.
APP_UTC_OFFSET_HOURS="-3"

# ── Traducción del contenido (DeepL) ─────────────────────────────────────────
# Traduce a los 7 idiomas lo que escribe cada local: nombres de plato,
# descripciones y textos de bienvenida. Se traduce AL GUARDAR desde el panel,
# no al mostrar la carta, así la página pública no espera a ninguna API.
#
# Es OPCIONAL. Sin esta variable el sistema funciona igual y cada texto se
# muestra tal como lo cargó el local (que es como funcionaba antes).
#
# La clave se saca en https://www.deepl.com/pro-api . Las gratuitas terminan
# en ":fx" y el código deduce de ahí a qué host de DeepL pegar.
#DEEPL_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx"
